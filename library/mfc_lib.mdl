    <P Name="u_min">-600</P>
    <P Name="u_max">600</P>
    <P Name="use_external_command">off</P>
    <P Name="use_live_alpha">off</P>
    <P Name="Ts">0.01</P>
  </Block>
  <Annotation SID="2">
    <P Name="Name">All-in-one (start here)</P>
    <P Name="Position">[130, 145, 216, 156]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-1</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="4">
    <P Name="Name">Reference trajectory + ff derivatives, or an F_hat post-filter</P>
    <P Name="Position">[430, 145, 663, 156]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-2</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="6">
    <P Name="Name">in: y  -- add an external PID</P>
    <P Name="Position">[130, 305, 241, 316]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-3</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="8">
    <P Name="Name">in: y  -- add an external PID</P>
    <P Name="Position">[430, 305, 541, 316]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-4</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="10">
    <P Name="Name">in: y  -- decoupled only, no coupled variant exists</P>
    <P Name="Position">[730, 305, 925, 316]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-5</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="12">
    <P Name="Name">in: y  -- Y = y + Kd*int y; PID needs D = 0, ff = ddot_sp + Kd*dot_sp</P>
    <P Name="Position">[1030, 305, 1298, 316]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-6</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="14">
    <P Name="Name">in: err -- Kp folded, no Kd available at 1st order</P>
    <P Name="Position">[130, 485, 318, 496]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-7</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="16">
    <P Name="Name">in: err -- Kp and Kd folded, fb -&gt; Ground</P>
    <P Name="Position">[430, 485, 590, 496]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-8</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="18">
    <P Name="Name">u = (-F_hat + ff - fb)/alpha, optional clamp</P>
    <P Name="Position">[130, 665, 297, 676]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-9</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="20">
    <P Name="Name">in: y (n-by-1) -- ff = dot_sp at 1st order</P>
    <P Name="Position">[130, 845, 283, 856]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-10</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="22">
    <P Name="Name">in: y (n-by-1) -- vector signals, square n-by-n alpha</P>
    <P Name="Position">[430, 845, 633, 856]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-11</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="24">
    <P Name="Name">in: y (n-by-1) -- decoupled only; no internal smoothing</P>
    <P Name="Position">[730, 845, 944, 856]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-12</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="26">
    <P Name="Name">in: y (n-by-1) -- Y = y + Kd*int y, square n-by-n Kd and alpha</P>
    <P Name="Position">[1030, 845, 1270, 856]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-13</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="28">
    <P Name="Name">in: err (n-by-1) -- matrix Kp folded, no Kd at 1st order</P>
    <P Name="Position">[130, 1025, 341, 1036]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-14</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="30">
    <P Name="Name">in: err (n-by-1) -- matrix Kp and Kd folded, fb -&gt; Ground</P>
    <P Name="Position">[430, 1025, 651, 1036]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-15</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="32">
    <P Name="Name">channel-wise; the F_hat post-filter for the window estimator</P>
    <P Name="Position">[730, 1025, 966, 1036]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-16</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="34">
    <P Name="Name">u = alpha\(-F_hat + ff - fb), vector signals</P>
    <P Name="Position">[1030, 1025, 1194, 1036]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-17</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="36">
    <P Name="Name">every non-Riachy variant on the mask; n = 1 reproduces the SISO core</P>
    <P Name="Position">[130, 1205, 414, 1216]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-18</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="38">
    <P Name="Name">in: y -- order/estimator/n on the mask, fixed ports; swap in the specific block to ship</P>
    <P Name="Position">[430, 1205, 760, 1216]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-19</P>
    <P Name="FontSize">9</P>
  </Annotation>
  <Annotation SID="39">
    <P Name="Name">Closing a composed loop

err = y - sp_filt   (measurement minus FILTERED setpoint, this sign)
u_prev needs a real Unit Delay -- the estimator wants the command
  that was actually applied over the last sample.

decoupled estimator:  err -&gt; [Discrete PID: Kp, Kd, Ki] -&gt; command/fb
Riachy estimator:     err -&gt; [Discrete PID: Kp, Ki, D = 0] -&gt; command/fb
                      ff = ddot_sp + Kd*dot_sp (Kd is already in Y)
coupled estimator:    command/fb -&gt; Ground
                      (or a Ki integrator on err, if you want one)</P>
    <P Name="Position">[700, 560, 1012, 672]</P>
    <P Name="InternalMargins">[0, 0, 0, 0]</P>
    <P Name="ZOrder">-20</P>
  </Annotation>
</System>

