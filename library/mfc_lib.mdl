  <Block BlockType="MATLABSystem" Name="MFC Controller, n channels (dev bench)" SID="35">
    <PortCounts in="3" out="5"/>
    <P Name="Position">[40, 1100, 220, 1190]</P>
    <P Name="ZOrder">21</P>
    <P Name="System">mfc_mimo_core</P>
    <P Name="MaskType">mfc_mimo_core</P>
    <P Name="n">2</P>
    <P Name="model_order">Second order (ddot_y = F + alpha*u)</P>
    <P Name="controller_structure">Decoupled (measurement-driven estimator, explicit iP/iPD)</P>
    <P Name="estimator_type">Algebraic (growing window)</P>
    <P Name="alpha">eye( 2 )</P>
    <P Name="Kp">25</P>
    <P Name="Kd">10</P>
    <P Name="Ki">0</P>
    <P Name="SimulateUsing">Code generation</P>
    <P Name="ref_filter_window">10</P>
    <P Name="est_filter_window">10</P>
    <P Name="command_filter">1</P>
    <P Name="est_hold_time">0.1</P>
    <P Name="use_ref_filter">on</P>
    <P Name="use_control_sat">off</P>
    <P Name="u_min">-600</P>
    <P Name="u_max">600</P>
    <P Name="use_external_command">off</P>
    <P Name="use_live_alpha">off</P>
    <P Name="Ts">0.01</P>
  </Block>
  <Block BlockType="MATLABSystem" Name="MFC SISO Controller" SID="1">
    <PortCounts in="3" out="5"/>
    <P Name="Position">[40, 40, 220, 130]</P>
    <P Name="ZOrder">4</P>
    <P Name="System">mfc_siso_core</P>
    <P Name="MaskType">mfc_siso_core</P>
    <P Name="model_order">Second order (ddot_y = F + alpha*u)</P>
    <P Name="controller_structure">Coupled (error-driven estimator, poles folded)</P>
    <P Name="estimator_type">Algebraic (growing window)</P>
    <P Name="alpha">1</P>
    <P Name="Kp">25</P>
    <P Name="Kd">10</P>
